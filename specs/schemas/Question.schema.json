{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://thought-os.dev/schemas/Question.schema.json",
  "title": "Question",
  "description": "独立存在的开放性问题节点，不要求已有答案，与 Thought 地位平等。定义见 specs/concepts/Question.md。",
  "type": "object",
  "additionalProperties": false,
  "required": ["id", "user_id", "content", "status", "origin_type", "created_at", "updated_at"],
  "properties": {
    "id": { "type": "string" },
    "user_id": { "type": "string" },
    "content": { "type": "string", "minLength": 1 },
    "status": {
      "type": "string",
      "enum": ["pending", "open", "archived"]
    },
    "origin_type": {
      "type": "string",
      "enum": ["user_authored", "ai_suggested"]
    },
    "evidence_ids": {
      "type": "array",
      "items": { "type": "string" },
      "uniqueItems": true,
      "default": []
    },
    "parent_question_id": {
      "type": ["string", "null"],
      "default": null
    },
    "space_id": {
      "type": ["string", "null"],
      "default": null,
      "description": "所属 Thinking Space id（Product Aggregate Layer v0.1）。上层聚合归属，不参与 Kernel 校验"
    },
    "created_at": { "type": "string", "format": "date-time" },
    "updated_at": { "type": "string", "format": "date-time" }
  },
  "allOf": [
    {
      "if": { "properties": { "origin_type": { "const": "ai_suggested" } } },
      "then": {
        "properties": {
          "evidence_ids": { "type": "array", "minItems": 1 }
        }
      }
    },
    {
      "if": { "properties": { "status": { "const": "pending" } } },
      "then": {
        "properties": { "origin_type": { "const": "ai_suggested" } }
      }
    }
  ],
  "not": {
    "anyOf": [
      { "required": ["answer"] },
      { "required": ["is_answered"] }
    ]
  }
}
