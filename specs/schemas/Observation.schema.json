{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://thought-os.dev/schemas/Observation.schema.json",
  "title": "Observation",
  "description": "AI 对 Evidence 的客观描述，不含意义解释。定义见 specs/concepts/Observation.md。",
  "type": "object",
  "additionalProperties": false,
  "required": ["id", "user_id", "content", "evidence_ids", "status", "created_at"],
  "properties": {
    "id": { "type": "string" },
    "user_id": { "type": "string" },
    "content": {
      "type": "string",
      "minLength": 1,
      "description": "客观、可核验的描述，不含解释性措辞"
    },
    "evidence_ids": {
      "type": "array",
      "items": { "type": "string" },
      "minItems": 1,
      "uniqueItems": true
    },
    "space_id": {
      "type": ["string", "null"],
      "default": null,
      "description": "Runtime v2.0：所属思考空间，用于观察流按空间过滤。由抽取/合成流水线写入。"
    },
    "pattern_type": {
      "type": "string",
      "enum": ["recurrence", "contradiction", "lattice_synthesis", "single_mention", "recurring_pattern", "explicit_contradiction", "concept_drift"],
      "description": "v0.1 抽取层只生成 recurrence（重复出现）/contradiction（明确矛盾），二者为 ADR-0025 关系闭集最小启用项；lattice_synthesis=晶格漂移合成后台通道（ADR-0013，独立保留）；single_mention/recurring_pattern/explicit_contradiction/concept_drift 为存量兼容值（concept_drift=语言层/主题层可观察变化，A2 Concept Tracking），v0.1 抽取层不再生成。"
    },
    "status": {
      "type": "string",
      "enum": ["active", "dismissed"]
    },
    "dismissed_at": {
      "type": ["string", "null"],
      "format": "date-time",
      "default": null
    },
    "created_at": {
      "type": "string",
      "format": "date-time"
    }
  },
  "allOf": [
    {
      "if": { "properties": { "status": { "const": "dismissed" } } },
      "then": { "required": ["dismissed_at"] }
    }
  ],
  "not": {
    "required": ["confidence"]
  }
}
