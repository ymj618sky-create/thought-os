{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://thought-os.dev/schemas/Interpretation.schema.json",
  "title": "Interpretation",
  "description": "AI 对 Evidence/Observation 的意义赋予或推断，必须标注置信度，用户拥有完全确认/驳回权。定义见 specs/concepts/Interpretation.md。",
  "type": "object",
  "additionalProperties": false,
  "required": ["id", "user_id", "content", "confidence", "status", "created_at"],
  "properties": {
    "id": { "type": "string" },
    "user_id": { "type": "string" },
    "content": {
      "type": "string",
      "minLength": 1,
      "description": "应使用推测性措辞，不得使用定论性措辞"
    },
    "evidence_ids": {
      "type": "array",
      "items": { "type": "string" },
      "uniqueItems": true,
      "default": []
    },
    "observation_ids": {
      "type": "array",
      "items": { "type": "string" },
      "uniqueItems": true,
      "default": []
    },
    "confidence": {
      "type": "number",
      "minimum": 0,
      "maximum": 1,
      "description": "遵循 S-6.1，缺失视为生成失败，不得省略"
    },
    "confidence_rationale": {
      "type": "string"
    },
    "tension": {
      "type": ["string", "null"],
      "default": null,
      "description": "Runtime v2.0：该 Interpretation 揭示的认知张力摘要（如\"我既想要稳定又想要自由\"）。用于 Confirmation 时计算 Thought 的 projection.tension。"
    },
    "status": {
      "type": "string",
      "enum": ["pending", "confirmed", "rejected", "superseded"]
    },
    "source": {
      "type": "string",
      "enum": ["user", "mirror"],
      "description": "Bidirectional Thought Formation (Phase B)：认知来源。user=用户表达（默认/历史兼容）；mirror=Mirror 回复（pending 候选，需用户确认才可能在 confirmation 落 Thought）。"
    },
    "superseded_by": {
      "type": ["string", "null"],
      "default": null
    },
    "space_id": {
      "type": ["string", "null"],
      "default": null,
      "description": "所属 Thinking Space id（Product Aggregate Layer v0.1）。抽取时归属，确认后继承给 Thought。"
    },
    "created_at": { "type": "string", "format": "date-time" },
    "confirmed_at": { "type": ["string", "null"], "format": "date-time", "default": null }
  },
  "allOf": [
    {
      "if": { "properties": { "status": { "const": "confirmed" } } },
      "then": { "required": ["confirmed_at"] }
    },
    {
      "if": { "properties": { "status": { "const": "superseded" } } },
      "then": { "required": ["superseded_by"] }
    }
  ],
  "anyOf": [
    { "required": ["evidence_ids"], "properties": { "evidence_ids": { "minItems": 1 } } },
    { "required": ["observation_ids"], "properties": { "observation_ids": { "minItems": 1 } } }
  ],
  "not": {
    "anyOf": [
      { "required": ["personality_type"] },
      { "required": ["psychological_profile"] }
    ]
  }
}
